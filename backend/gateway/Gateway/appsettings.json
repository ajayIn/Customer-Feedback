{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    }
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/identity/{**catch-all}"
        }
      },
      "feedback": {
        "ClusterId": "feedback",
        "Match": {
          "Path": "/api/feedback/{**catch-all}"
        }
      },
      "reports": {
        "ClusterId": "reporting",
        "Match": {
          "Path": "/api/reports/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5101"
          }
        }
      },
      "feedback": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5102"
          }
        }
      },
      "reporting": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5103"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
