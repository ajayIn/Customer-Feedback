{
  "Logging": {
    "File": {
      "Directory": "logs",
      "RetainedFileCountLimit": 14
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "MassTransit": "Information"
      }
    }
  },
  "Jwt": {
    "Issuer": "customer-feedback",
    "Audience": "customer-feedback"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Username": "guest",
    "Password": "guest"
  },
  "AllowedHosts": "*"
}
